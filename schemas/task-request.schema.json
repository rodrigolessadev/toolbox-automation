{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigolessadev/toolbox-automation/schemas/task-request.schema.json",
  "title": "Solicitação de tarefa",
  "description": "Contrato para representar uma solicitação de trabalho da automação.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "repositories",
    "risk_level",
    "requested_by",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "toolbox-automation",
          "toolbox",
          "toolbox-plugins"
        ]
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "approval_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "approved",
        "in_progress",
        "blocked",
        "validation",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
