{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rodrigolessadev/toolbox-automation/schemas/analysis-result.schema.json",
  "title": "Resultado da análise",
  "description": "Resultado produzido pelo agente de análise antes do planejamento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "summary",
    "affected_repositories",
    "affected_files",
    "dependencies",
    "risks",
    "findings",
    "recommended_action",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "affected_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "toolbox-automation",
          "toolbox",
          "toolbox-plugins"
        ]
      }
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "path",
          "reason",
          "change_type"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "enum": [
              "toolbox-automation",
              "toolbox",
              "toolbox-plugins"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "change_type": {
            "type": "string",
            "enum": [
              "create",
              "modify",
              "delete",
              "rename",
              "read_only"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "severity",
          "mitigation"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "graph_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "summary"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "proceed_to_planning",
        "request_clarification",
        "request_approval",
        "stop"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    }
  }
}
